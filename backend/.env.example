# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb://localhost:27017/table-reservation
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=8h
RESTAURANT_TIME_ZONE=Europe/Madrid
CORS_ORIGINS=http://localhost:5173
PORT=3000

# Booking rules (feature 002). Whole numbers; the defaults are shown.
# Length of every reservation, in minutes (15-480).
RESERVATION_DURATION_MINUTES=120
# Spacing of the listed start times, in minutes (5-120).
TIME_SLOT_INTERVAL_MINUTES=15
# Minimum time between now and the reservation start, in minutes (0-1440).
MIN_NOTICE_MINUTES=60
# How many days ahead, counting today and inclusive, can be booked (1-365).
BOOKING_HORIZON_DAYS=60

# Confirmation and cancellation emails (feature 003).
# SMTP server URL, e.g. smtps://user:password@smtp.example.com:465. Leave it unset to send no
# email (the application works and logs "email_skipped"). It may hold credentials: keep it secret.
#SMTP_URL=smtps://user:password@smtp.example.com:465
# Sender address; required when SMTP_URL is set. Example: La Mesa <noreply@example.com>
EMAIL_FROM=
# Give up on a send after this many milliseconds (100-120000).
EMAIL_TIMEOUT_MS=10000
# Name used in the email subjects.
RESTAURANT_NAME=the restaurant
# Page that reads the cancellation code from "#code=..."; must not contain a fragment.
CANCEL_LINK_BASE_URL=http://localhost:5173/cancel

# Used only by `npm run seed:staff`
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
