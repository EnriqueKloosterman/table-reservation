{
  "name": "table-reservation-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "seed:staff": "tsx --env-file-if-exists=.env scripts/seed-staff.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1",
    "cors": "^2.8",
    "express": "^5.3",
    "jose": "^6.2",
    "mongoose": "^9.12",
    "nodemailer": "^10.4.0",
    "swagger-ui-express": "^5.0",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10",
    "mongodb-memory-server": "^11.3",
    "supertest": "^7.3",
    "tsx": "^4.23",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72",
    "vitest": "^5.1"
  }
}
